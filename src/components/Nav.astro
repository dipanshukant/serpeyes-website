---
import { SITE, NAV_LINKS } from '../content/config.js';

const currentPath = Astro.url.pathname;
---

<header id="main-header" style="position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); border-bottom: 1px solid #e2e8f0;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
    <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 0px;">
      <img src="/logo.svg" alt="SerpEyes" style="height: 45px; width: auto; margin-top: -5px;" />
      <span style="font-family: Sora, sans-serif; font-weight: 700; font-size: 24px; color: #2c3e50; letter-spacing: -0.02em;">
        <span style="color: #2c3e50;">Serp</span><span style="color: #1B4FD8;">eyes</span>
      </span>
    </a>
    
    <nav class="desktop-nav" style="display: flex; align-items: center; gap: 32px;">
      {NAV_LINKS.map(link => (
        <a 
          href={link.href}
          class={`nav-link ${currentPath === link.href ? 'active-nav' : ''}`}
          style={`text-decoration: none; color: ${currentPath === link.href ? '#1B4FD8' : '#475569'}; font-size: 15px; font-weight: 500;`}
        >
          {link.label}
        </a>
      ))}
      <a href="/request-demo" class="btn-primary" style="padding: 9px 22px; border-radius: 8px; font-size: 14px; text-decoration: none; display: inline-block;">Contact Us</a>
    </nav>
    
    <div class="mobile-menu" id="mobile-menu-btn">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
  
  <div id="mobile-menu-panel" style="display: none; background: white; border-top: 1px solid #e2e8f0; padding: 16px 24px 20px;">
    {NAV_LINKS.map(link => (
      <a 
        href={link.href}
        style="display: block; padding: 12px 0; color: #1e293b; text-decoration: none; font-size: 15px; font-weight: 500; border-bottom: 1px solid #f1f5f9;"
      >
        {link.label}
      </a>
    ))}
    <a href="/request-demo" class="btn-primary" style="width: 100%; padding: 12px; border-radius: 8px; font-size: 15px; margin-top: 16px; text-decoration: none; display: block; text-align: center;">Contact Us</a>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuPanel = document.getElementById('mobile-menu-panel');
  const menuSpans = menuBtn?.querySelectorAll('span');
  
  let menuOpen = false;
  
  menuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    if (menuPanel) {
      menuPanel.style.display = menuOpen ? 'block' : 'none';
    }
    if (menuSpans) {
      menuSpans[0].style.transform = menuOpen ? 'rotate(45deg) translate(5px, 5px)' : '';
      menuSpans[1].style.opacity = menuOpen ? '0' : '1';
      menuSpans[2].style.transform = menuOpen ? 'rotate(-45deg) translate(5px, -5px)' : '';
    }
  });
  
  // Close menu when clicking on a link
  const mobileLinks = menuPanel?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      if (menuPanel) menuPanel.style.display = 'none';
      if (menuSpans) {
        menuSpans[0].style.transform = '';
        menuSpans[1].style.opacity = '1';
        menuSpans[2].style.transform = '';
      }
    });
  });
</script>
