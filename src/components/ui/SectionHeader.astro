---
interface Props {
  badge?: string;
  headline: string;
  subheadline?: string;
  centered?: boolean;
  dark?: boolean;
}

const { badge, headline, subheadline, centered = true, dark = false } = Astro.props;
const textColor = dark ? 'white' : '#0f172a';
const subColor = dark ? '#64748b' : '#64748b';
---

<div class="animate-on-scroll" style={`text-align: ${centered ? 'center' : 'left'}; margin-bottom: 56px;`}>
  {badge && (
    <span class="badge" style={`margin-bottom: 16px; display: inline-block; ${dark ? 'background: rgba(27,79,216,0.15); color: #60a5fa;' : ''}`}>
      {badge}
    </span>
  )}
  <h2 style={`font-family: Sora, sans-serif; font-size: clamp(28px, 4vw, 42px); font-weight: 700; color: ${textColor}; margin: 0 0 16px; letter-spacing: -0.02em;`}>
    {headline}
  </h2>
  {subheadline && (
    <p style={`font-size: 17px; color: ${subColor}; max-width: 560px; margin: ${centered ? '0 auto' : '0'}; line-height: 1.7;`}>
      {subheadline}
    </p>
  )}
</div>
