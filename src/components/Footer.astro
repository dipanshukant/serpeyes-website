---
import { SITE, NAV_LINKS, FOOTER_RESOURCES, FOOTER_SOCIALS } from '../content/config.js';
---

<footer style="background: #0f172a; color: #94a3b8; padding: 64px 24px 32px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; margin-bottom: 48px;">
      <div>
        <div style="margin-bottom: 12px;">
          <img src="/logo.svg" alt="Serpeyes" style="height: 36px; width: auto; filter: brightness(0) invert(1);" />
        </div>
        <p style="font-size: 14px; line-height: 1.7; color: #64748b; max-width: 220px; margin: 0;">A digital growth agency helping businesses build, optimise and scale their online presence through web, app, SEO, AEO and marketing.</p>
      </div>
      
      <div>
        <h4 style="color: white; font-family: Sora, sans-serif; font-size: 14px; font-weight: 600; margin: 0 0 16px;">Company</h4>
        {NAV_LINKS.map(link => (
          <div style="margin-bottom: 10px;">
            <a href={link.href} style="color: #64748b; text-decoration: none; font-size: 14px; transition: color 0.15s;" onmouseenter="this.style.color='white'" onmouseleave="this.style.color='#64748b'">
              {link.label}
            </a>
          </div>
        ))}
      </div>
      
      <div>
        <h4 style="color: white; font-family: Sora, sans-serif; font-size: 14px; font-weight: 600; margin: 0 0 16px;">Resources</h4>
        {FOOTER_RESOURCES.map(item => (
          <div style="margin-bottom: 10px;">
            <a href={item === 'Blog' ? '/blog' : item === 'Services' ? '/services' : '#'} style="color: #64748b; text-decoration: none; font-size: 14px;" onmouseenter="this.style.color='white'" onmouseleave="this.style.color='#64748b'">
              {item}
            </a>
          </div>
        ))}
      </div>
      
      <div>
        <h4 style="color: white; font-family: Sora, sans-serif; font-size: 14px; font-weight: 600; margin: 0 0 16px;">Contact</h4>
        <p style="font-size: 14px; color: #64748b; margin: 0 0 8px;">{SITE.email}</p>
        {SITE.phones.map(p => (
          <a href={`tel:${p.tel}`} style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #64748b; margin: 0 0 8px; text-decoration: none; transition: color 0.15s;" onmouseenter="this.style.color='white'" onmouseleave="this.style.color='#64748b'">
            <span style="display: inline-flex; width: 20px; height: 14px; flex-shrink: 0; border-radius: 2px; overflow: hidden;" set:html={p.svg} />
            {p.number}
          </a>
        ))}
        <p style="font-size: 14px; color: #64748b; margin: 0 0 20px;">{SITE.location}</p>
        <div style="display: flex; gap: 12px;">
          {FOOTER_SOCIALS.map(social => (
            <a href="#" style="color: #64748b; font-size: 13px; text-decoration: none; border: 1px solid #1e293b; padding: 4px 12px; border-radius: 6px; transition: all 0.15s;" onmouseenter="this.style.color='white'; this.style.borderColor='#334155'" onmouseleave="this.style.color='#64748b'; this.style.borderColor='#1e293b'">
              {social}
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div style="border-top: 1px solid #1e293b; padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <p style="font-size: 13px; color: #475569; margin: 0;">{SITE.copyright}</p>
      <div style="display: flex; gap: 20px;">
        {['Privacy Policy', 'Terms of Service'].map(item => (
          <a href={item === 'Privacy Policy' ? '/privacy' : '/terms'} style="color: #475569; text-decoration: none; font-size: 13px;">{item}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
