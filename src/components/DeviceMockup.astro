---
// Static browser + phone mockup for the homepage hero. No animation, no
// single-service framing, just a generic "we build sites and apps" visual.

const STATS = [
  { icon: '⚡', value: '98', label: 'Speed score', accent: '#1B4FD8', bg: '#eff4ff' },
  { icon: '★', value: '4.9', label: 'Client rating', accent: '#ca8a04', bg: '#fefce8' },
];

const APP_ROWS = [
  { icon: '💬', title: 'New enquiry', sub: '2 min ago', accent: '#1B4FD8', bg: '#dbeafe' },
  { icon: '📈', title: 'Traffic up 24%', sub: 'This week', accent: '#059669', bg: '#dcfce7' },
  { icon: '✅', title: 'Site live', sub: 'Deployed', accent: '#7c3aed', bg: '#ede9fe' },
];
---

<div style="position: relative; max-width: 480px; margin: 0 auto; padding: 34px 60px 70px 4px;">
  <!-- Floating badge -->
  <div style="position: absolute; top: 0; left: 12px; z-index: 2; display: flex; align-items: center; gap: 8px; background: #0f172a; border: 1px solid rgba(255,255,255,0.12); border-radius: 100px; padding: 8px 16px 8px 8px; box-shadow: 0 12px 28px rgba(0,0,0,0.35);">
    <div style="width: 26px; height: 26px; border-radius: 50%; background: #dcfce7; display: flex; align-items: center; justify-content: center; font-size: 13px;">🚀</div>
    <span style="font-family: 'Sora', sans-serif; font-size: 12px; font-weight: 600; color: white; white-space: nowrap;">Launched in 6 weeks</span>
  </div>

  <!-- Browser window -->
  <div style="margin-top: 28px; background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08);">
    <div style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 10px 14px; display: flex; align-items: center; gap: 10px;">
      <div style="display: flex; gap: 5px;">
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #ef4444;"></div>
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #f59e0b;"></div>
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #22c55e;"></div>
      </div>
      <div style="flex: 1; background: white; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 10px; font-size: 11px; color: #94a3b8; font-family: 'DM Sans', sans-serif;">
        yourbusiness.com
      </div>
    </div>
    <div style="padding: 20px; font-family: 'DM Sans', sans-serif;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 7px;">
          <div style="width: 22px; height: 22px; background: #1B4FD8; border-radius: 6px;"></div>
          <div style="width: 60px; height: 8px; background: #cbd5e1; border-radius: 4px;"></div>
        </div>
        <div style="display: flex; gap: 14px; font-size: 10px; color: #94a3b8; font-weight: 600;">
          <span>Services</span>
          <span>Work</span>
          <span>Contact</span>
        </div>
      </div>
      <div style="width: 78%; height: 16px; background: #0f172a; border-radius: 4px; margin-bottom: 10px;"></div>
      <div style="width: 55%; height: 16px; background: #0f172a; border-radius: 4px; margin-bottom: 14px;"></div>
      <div style="width: 90%; height: 8px; background: #e2e8f0; border-radius: 4px; margin-bottom: 8px;"></div>
      <div style="width: 70%; height: 8px; background: #e2e8f0; border-radius: 4px; margin-bottom: 18px;"></div>
      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <div style="width: 100px; height: 30px; background: #1B4FD8; border-radius: 7px;"></div>
        <div style="width: 84px; height: 30px; background: white; border: 1.5px solid #1B4FD8; border-radius: 7px;"></div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
        {STATS.map(s => (
          <div style={`display: flex; align-items: center; gap: 8px; background: ${s.bg}; border: 1px solid #eef2f8; border-radius: 8px; padding: 9px 10px;`}>
            <span style="font-size: 15px;">{s.icon}</span>
            <div>
              <div style={`font-family: 'Sora', sans-serif; font-size: 14px; font-weight: 700; color: ${s.accent}; line-height: 1.1;`}>{s.value}</div>
              <div style="font-size: 9px; color: #64748b; font-weight: 600;">{s.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Phone mockup, tucked into bottom-right corner -->
  <div style="position: absolute; right: -16px; bottom: -16px; width: 138px; background: #0f172a; border-radius: 26px; padding: 8px; box-shadow: 0 20px 40px rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.12);">
    <div style="background: white; border-radius: 19px; overflow: hidden; font-family: 'DM Sans', sans-serif;">
      <div style="padding: 12px 12px 8px; display: flex; align-items: center; gap: 6px;">
        <div style="width: 16px; height: 16px; background: #1B4FD8; border-radius: 5px;"></div>
        <div style="width: 44px; height: 6px; background: #cbd5e1; border-radius: 3px;"></div>
      </div>
      <div style="padding: 0 10px 12px; display: flex; flex-direction: column; gap: 6px;">
        {APP_ROWS.map(row => (
          <div style="display: flex; align-items: center; gap: 6px; background: #f8faff; border: 1px solid #eef2f8; border-radius: 7px; padding: 6px 7px;">
            <div style={`width: 18px; height: 18px; border-radius: 5px; background: ${row.bg}; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 9px;`}>{row.icon}</div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 8px; font-weight: 700; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{row.title}</div>
              <div style="font-size: 7px; color: #94a3b8;">{row.sub}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="border-top: 1px solid #eef2f8; padding: 8px 0; display: flex; justify-content: space-around;">
        {[1, 2, 3, 4].map(i => (
          <div style={`width: 14px; height: 14px; border-radius: 4px; background: ${i === 1 ? '#1B4FD8' : '#e2e8f0'};`}></div>
        ))}
      </div>
    </div>
  </div>
</div>
