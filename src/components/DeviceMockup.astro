---
// Static browser + phone mockup for the homepage hero. No animation, no
// single-service framing, just a generic "we build sites and apps" visual.

const STATS = [
  { icon: '⚡', value: '98', label: 'Speed score', accent: '#1B4FD8', bg: '#eff4ff' },
  { icon: '★', value: '4.9', label: 'Client rating', accent: '#ca8a04', bg: '#fefce8' },
];

const APP_ROWS = [
  { icon: '💬', title: 'New enquiry', sub: '2 min ago', accent: '#1B4FD8', bg: '#dbeafe' },
  { icon: '📈', title: 'Traffic up 24%', sub: 'This week', accent: '#059669', bg: '#dcfce7' },
  { icon: '✅', title: 'Site live', sub: 'Deployed', accent: '#7c3aed', bg: '#ede9fe' },
];
---

<div style="position: relative; max-width: 480px; margin: 0 auto; padding: 20px 24px 92px 0;">
  <!-- Browser window -->
  <div style="position: relative; background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08);">
    <!-- Badge pinned to the top-left corner of the card -->
    <div style="position: absolute; top: -14px; left: 20px; z-index: 2; display: flex; align-items: center; gap: 7px; background: #0f172a; border: 1px solid rgba(255,255,255,0.14); border-radius: 100px; padding: 6px 14px 6px 6px; box-shadow: 0 10px 22px rgba(0,0,0,0.35);">
      <div style="width: 22px; height: 22px; border-radius: 50%; background: #dcfce7; display: flex; align-items: center; justify-content: center; font-size: 11px;">🚀</div>
      <span style="font-family: 'Sora', sans-serif; font-size: 11px; font-weight: 600; color: white; white-space: nowrap;">This site: delivered in 6 weeks</span>
    </div>

    <div style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 10px 14px; display: flex; align-items: center; gap: 10px; margin-top: 14px;">
      <div style="display: flex; gap: 5px;">
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #ef4444;"></div>
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #f59e0b;"></div>
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #22c55e;"></div>
      </div>
      <div style="flex: 1; background: white; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 10px; font-size: 11px; color: #94a3b8; font-family: 'DM Sans', sans-serif;">
        yourbusiness.com
      </div>
    </div>
    <div style="padding: 20px; font-family: 'DM Sans', sans-serif;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 7px;">
          <div style="width: 22px; height: 22px; background: #1B4FD8; border-radius: 6px; flex-shrink: 0;"></div>
          <span style="font-family: 'Sora', sans-serif; font-size: 13px; font-weight: 700; color: #0f172a;">YourBrand</span>
        </div>
        <div style="display: flex; gap: 14px; font-size: 11px; color: #64748b; font-weight: 600;">
          <span>Services</span>
          <span>Work</span>
          <span>Contact</span>
        </div>
      </div>
      <h3 style="font-family: 'Sora', sans-serif; font-size: 19px; font-weight: 700; color: #0f172a; margin: 0 0 8px; line-height: 1.25;">
        Grow Your Business Online
      </h3>
      <p style="font-size: 12px; color: #64748b; line-height: 1.6; margin: 0 0 18px; max-width: 300px;">
        A fast, modern website built to turn visitors into customers.
      </p>
      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <div style="height: 30px; padding: 0 16px; background: #1B4FD8; border-radius: 7px; display: flex; align-items: center; font-size: 12px; font-weight: 700; color: white; font-family: 'Sora', sans-serif;">Get Started</div>
        <div style="height: 30px; padding: 0 16px; background: white; border: 1.5px solid #1B4FD8; border-radius: 7px; display: flex; align-items: center; font-size: 12px; font-weight: 700; color: #1B4FD8; font-family: 'Sora', sans-serif;">Learn More</div>
      </div>
      <div style="display: flex; gap: 10px;">
        {STATS.map(s => (
          <div style={`display: flex; align-items: center; gap: 8px; background: ${s.bg}; border: 1px solid #eef2f8; border-radius: 8px; padding: 9px 12px; width: 128px; flex-shrink: 0;`}>
            <span style="font-size: 15px;">{s.icon}</span>
            <div>
              <div style={`font-family: 'Sora', sans-serif; font-size: 14px; font-weight: 700; color: ${s.accent}; line-height: 1.1;`}>{s.value}</div>
              <div style="font-size: 9px; color: #64748b; font-weight: 600;">{s.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Phone mockup, tucked into the empty bottom-right corner -->
  <div style="position: absolute; right: -8px; bottom: 44px; width: 136px; background: #0f172a; border-radius: 26px; padding: 8px; box-shadow: 0 20px 40px rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.12);">
    <div style="background: white; border-radius: 19px; overflow: hidden; font-family: 'DM Sans', sans-serif;">
      <div style="padding: 12px 12px 8px; display: flex; align-items: center; gap: 6px;">
        <div style="width: 16px; height: 16px; background: #1B4FD8; border-radius: 5px;"></div>
        <span style="font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 700; color: #0f172a;">Dashboard</span>
      </div>
      <div style="padding: 0 10px 12px; display: flex; flex-direction: column; gap: 6px;">
        {APP_ROWS.map(row => (
          <div style="display: flex; align-items: center; gap: 6px; background: #f8faff; border: 1px solid #eef2f8; border-radius: 7px; padding: 6px 7px;">
            <div style={`width: 18px; height: 18px; border-radius: 5px; background: ${row.bg}; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 9px;`}>{row.icon}</div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 8px; font-weight: 700; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{row.title}</div>
              <div style="font-size: 7px; color: #94a3b8;">{row.sub}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="border-top: 1px solid #eef2f8; padding: 8px 0; display: flex; justify-content: space-around;">
        {[1, 2, 3, 4].map(i => (
          <div style={`width: 14px; height: 14px; border-radius: 4px; background: ${i === 1 ? '#1B4FD8' : '#e2e8f0'};`}></div>
        ))}
      </div>
    </div>
  </div>
</div>
