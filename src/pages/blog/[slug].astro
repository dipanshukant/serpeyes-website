---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../content/config.js';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const isLaunchPost = post.slug === 'serpeyes-digital-growth-agency-what-we-do';
const isAeoCheckPost = post.slug === 'how-to-check-if-your-business-shows-up-in-ai-search';

const tocItems = isLaunchPost
  ? [
      { id: 'it-started-with-a-gap', label: 'It Started with a Gap' },
      { id: 'what-serpeyes-is-now', label: 'What Serpeyes Is Now' },
      { id: 'what-we-offer', label: 'What We Offer' },
      { id: 'why-we-expanded', label: 'Why We Expanded' },
      { id: 'who-this-is-for', label: 'Who This Is For' },
      { id: 'how-we-work', label: 'How We Work' },
      { id: 'what-happens-next', label: 'What Happens Next' },
      { id: 'one-last-thing', label: 'One Last Thing' },
    ]
  : isAeoCheckPost
  ? [
      { id: 'why-this-matters', label: 'Why This Matters' },
      { id: 'the-questions-to-ask', label: 'The Questions to Ask' },
      { id: 'good-answer-vs-bad-answer', label: 'A Good Answer vs a Bad Answer' },
      { id: 'how-to-fix-it', label: 'How to Fix It' },
      { id: 'how-often-to-check', label: 'How Often to Check' },
      { id: 'get-help', label: 'Get Help If You Are Stuck' },
    ]
  : [
      { id: 'why-this-matters', label: 'Why this matters' },
      { id: 'what-to-fix-first', label: 'What to fix first' },
      { id: 'execution-checklist', label: 'Execution checklist' },
      { id: 'common-mistakes', label: 'Common mistakes' },
      { id: 'next-30-days', label: 'Next 30 days' },
    ];

const sameTagPosts = BLOG_POSTS.filter((item) => item.slug !== post.slug && item.tag === post.tag);
const otherPosts = BLOG_POSTS.filter((item) => item.slug !== post.slug && item.tag !== post.tag);
const relatedPosts = [...sameTagPosts, ...otherPosts].slice(0, 3);
---

<BaseLayout
  title={post.metaTitle || `${post.title} - Serpeyes Blog`}
  description={post.metaDescription || post.excerpt}
>
  <div id="reading-progress" style="position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: linear-gradient(90deg, #1B4FD8 0%, #3b82f6 100%); z-index: 100;"></div>
  <main>
    <section style="padding: 64px 24px 24px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div style="max-width: 780px; margin-left: 30px;">
          <a href="/blog" style="display: inline-block; margin-bottom: 18px; font-size: 14px; color: #1B4FD8; text-decoration: none; font-weight: 600;">&larr; Back to Blog</a>
          <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap;">
            <span style="background: #eff4ff; color: #1B4FD8; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 100px;">{post.tag}</span>
            <span style="font-size: 13px; color: #94a3b8;">{post.date}</span>
            <span style="font-size: 13px; color: #94a3b8;">{post.readTime}</span>
          </div>
          <h1 style="font-family: Sora, sans-serif; font-size: 40px; font-weight: 700; color: #0f172a; margin: 0 0 14px; line-height: 1.2; letter-spacing: -0.02em;">
            {post.title}
          </h1>
          <p style="font-size: 18px; color: #475569; line-height: 1.8; margin: 0;">
            {post.excerpt}
          </p>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px;">
            <button id="copy-link-btn" type="button" style="background: #dfe8ff; color: #1B4FD8; border: 1px solid #b8cdfa; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Copy Link</button>
            <button id="share-linkedin-btn" type="button" style="background: #dde7ff; color: #1d4ed8; border: 1px solid #b8cdfa; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Share on LinkedIn</button>
            <button id="share-x-btn" type="button" style="background: #e2e8f0; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Share on X</button>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 24px 24px 88px; background: #eef2f7;">
      <div class="blog-layout" style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 28px; align-items: start;">
        <aside class="blog-toc" style="grid-column: 2; grid-row: 1; position: sticky; top: 92px; background: #e3eaf4; border: 1px solid #c6d2e3; border-radius: 14px; padding: 16px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);">
          <p style="margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #64748b; text-transform: uppercase;">In this article</p>
          <nav style="display: grid; gap: 8px;">
            {tocItems.map((item) => (
              <a href={`#${item.id}`} class="toc-link" data-section-id={item.id} style="font-size: 14px; color: #475569; text-decoration: none; line-height: 1.4; padding: 6px 8px; border-radius: 8px;">{item.label}</a>
            ))}
          </nav>

          <div style="border-top: 1px solid #e2e8f0; margin-top: 14px; padding-top: 14px;">
            <p style="margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #64748b; text-transform: uppercase;">Related posts</p>
            <div style="display: grid; gap: 10px;">
              {relatedPosts.map((item) => (
                <a href={`/blog/${item.slug}`} class="card-hover" style="text-decoration: none; background: #edf3fb; border: 1px solid #bccbe0; border-radius: 10px; padding: 10px; display: block;">
                  <span style="display: inline-block; background: #eff4ff; color: #1B4FD8; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 100px; margin-bottom: 6px;">{item.tag}</span>
                  <h4 style="font-family: Sora, sans-serif; font-size: 13px; color: #0f172a; margin: 0 0 5px; line-height: 1.35;">{item.title}</h4>
                  <p style="font-size: 11px; color: #64748b; margin: 0;">{item.readTime}</p>
                </a>
              ))}
            </div>
          </div>
        </aside>

        <div style="grid-column: 1; grid-row: 1;">
          <article id="article-content" class="animate-on-scroll" style="max-width: 780px; margin: 0 auto 28px; background: #ebf0f7; border: 1px solid #cbd7e6; border-radius: 16px; padding: 32px 28px;">
            {isLaunchPost ? (
              <>
                <section id="it-started-with-a-gap" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">It Started with a Gap</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We started Serpeyes focused on one thing: SEO. Along the way, the same pattern kept showing up.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Clients with strong SEO potential were held back by a website that was slow, hard to update or simply not built to convert. Clients who wanted an app had nowhere to turn without hiring a second, unrelated vendor. Clients who wanted marketing support ended up managing three separate teams that never talked to each other.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We kept referring this work out. Eventually we stopped referring it out and started building the capability ourselves.</p>
                </section>

                <section id="what-serpeyes-is-now" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Serpeyes Is Now</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Serpeyes is a digital growth agency. We help businesses establish, optimise and scale their online presence through website development, mobile app development, SEO, AEO and digital marketing.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We are not trying to be everything to everyone. We focus on the parts of a business's digital presence that need to work together to actually produce growth: the site or app people land on, and the search and marketing systems that bring them there.</p>
                </section>

                <section id="what-we-offer" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What We Offer</h2>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 8px;"><strong>Website & eCommerce Development:</strong> Custom business websites and online stores built on modern, secure technology.</li>
                    <li style="margin-bottom: 8px;"><strong>Mobile App Development:</strong> Android and iOS apps, from concept through to app store launch.</li>
                    <li style="margin-bottom: 8px;"><strong>UI/UX Design:</strong> Interfaces designed around how people actually use them, not assumptions.</li>
                    <li style="margin-bottom: 8px;"><strong>SEO:</strong> Technical, on-page and content SEO built for sustained visibility.</li>
                    <li style="margin-bottom: 8px;"><strong>AEO (Answer Engine Optimisation):</strong> Structuring content so AI tools like <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">ChatGPT</a> and <a href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">Perplexity</a> can find and recommend your business.</li>
                    <li><strong>Digital Marketing:</strong> Social media, content strategy and campaigns that turn attention into leads.</li>
                  </ul>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">See the full breakdown on our <a href="/services" style="color: #1B4FD8; text-decoration: underline;">Services page</a>.</p>
                </section>

                <section id="why-we-expanded" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why We Expanded</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">SEO alone can only do so much if the site it is pointing to is not built to convert. We saw this constantly: rankings improving, traffic increasing, and conversion rates barely moving because the website itself was the weak link.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Expanding into web development, app development and full digital marketing let us fix the whole system instead of one piece of it.</p>
                </section>

                <section id="who-this-is-for" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Who This Is For</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Serpeyes works with businesses at different stages.</p>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 8px;">If you need a new website or online store, see <a href="/web-development" style="color: #1B4FD8; text-decoration: underline;">Web Development</a>.</li>
                    <li style="margin-bottom: 8px;">If you have an app idea or need one built, see <a href="/app-development" style="color: #1B4FD8; text-decoration: underline;">App Development</a>.</li>
                    <li>If you already have a site and need more visibility, see our <a href="/services" style="color: #1B4FD8; text-decoration: underline;">Services page</a> for SEO, AEO and marketing.</li>
                  </ul>
                </section>

                <section id="how-we-work" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How We Work</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We do not apply the same playbook to every client. Every project starts with understanding your market, your customers and what is actually holding growth back, then we build a plan around that, not a template.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We also lean on AI-powered workflows for research, content and automation, so we can move faster without cutting corners on quality.</p>
                </section>

                <section id="what-happens-next" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Happens Next</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If any of this is relevant to your business, the best next step is a free consultation. We will look at what you have now, whether that is a website, an app idea or an existing SEO setup, and tell you honestly what would move the needle first.</p>
                </section>

                <section id="one-last-thing" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">One Last Thing</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We kept the name Serpeyes because the idea behind it has not changed: seeing what others miss. That used to mean SEO signals other tools ignored. Now it means seeing the whole picture of a business's digital presence, not just one piece of it.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If that resonates, <a href="/request-demo" style="color: #1B4FD8; text-decoration: underline;">get in touch</a>. We will respond within one business day.</p>
                </section>
              </>
            ) : isAeoCheckPost ? (
              <>
                <section id="why-this-matters" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why This Matters</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">More people are asking AI tools like ChatGPT for help finding a business. Instead of searching on Google, they just ask. If your business does not show up in that answer, that customer never finds you. They do not go looking further. They just pick from whatever the AI told them.</p>
                </section>

                <section id="the-questions-to-ask" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">The Questions to Ask</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Open ChatGPT, Perplexity, or any AI chat tool you have. Type in the kind of question a real customer would ask. Not your business name. A real question, like they do not know you exist yet.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">For example, if you run an aircon company in Singapore, try asking, who is a good aircon company in Singapore. If you run a bakery in London, ask, where is a good bakery in London.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Ask it two or three different ways. Change a word here and there. See what comes back each time.</p>
                </section>

                <section id="good-answer-vs-bad-answer" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">A Good Answer vs a Bad Answer</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">A good answer names your business. It might even explain why, like your reviews, your services, or your location.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">A bad answer either skips your business completely, or gets your details wrong. Wrong phone number. Wrong address. Wrong opening hours. That is almost worse than not showing up at all, because now the AI is telling people the wrong thing about you.</p>
                </section>

                <section id="how-to-fix-it" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How to Fix It</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">If you did not show up, or the details were wrong, here is where to start. Do these in order.</p>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 10px;"><strong>Make your details match everywhere.</strong> Your business name, address and phone number should be exactly the same on your website, your Google listing, and any directory you are on. Even small differences confuse AI tools.</li>
                    <li style="margin-bottom: 10px;"><strong>Say what you do in plain words.</strong> Not just pretty pictures. Actual sentences like, we fix aircon units in Singapore, same day service available.</li>
                    <li style="margin-bottom: 10px;"><strong>Keep your Google Business Profile filled in.</strong> Hours, photos, services, all of it. AI tools use this information too.</li>
                    <li><strong>Get real reviews.</strong> AI tools notice when real customers are talking about a business online.</li>
                  </ul>
                </section>

                <section id="how-often-to-check" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How Often to Check</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Do this check every month or two. AI answers change as the tools update. What worked last month might not work today. This is not a once and done task.</p>
                </section>

                <section id="get-help" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Get Help If You Are Stuck</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If you tried this and your business is missing, or the details are wrong, and you are not sure how to fix it, that is exactly what we do. <a href="/aeo" style="color: #1B4FD8; text-decoration: underline;">Book a free AEO check</a> and we will show you exactly what is missing and how to fix it.</p>
                </section>
              </>
            ) : (
              <>
                <section id="why-this-matters" style="scroll-margin-top: 110px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why this matters</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Most businesses lose momentum by treating SEO like disconnected tasks. Ranking gains come faster when technical fixes, content strategy and authority signals are executed in the right sequence for your market.</p>
                </section>

                <section id="what-to-fix-first" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What to fix first</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Start with crawlability, indexation and page speed. Then improve page-level targeting by tightening title tags, H1 hierarchy and internal links. This sequence prevents content effort from being wasted on a weak foundation.</p>
                </section>

                <section id="execution-checklist" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Execution checklist</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Use this weekly rhythm: publish one intent-focused article, refresh one high-potential page, and build at least one relevant local authority link. Small, consistent moves outperform sporadic large pushes.</p>
                </section>

                <section id="common-mistakes" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Common mistakes</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Teams often overinvest in top-funnel blog volume while service pages stay under-optimized. Another common miss is ignoring local trust signals, which directly impacts conversion once rankings improve.</p>
                </section>

                <section id="next-30-days" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Next 30 days</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0;">Build a simple 4-week plan with measurable outcomes: pages fixed, pages published, links acquired and lead growth trend. Reviewing this every week creates a compounding system rather than random SEO activity.</p>
                </section>
              </>
            )}
          </article>

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .toc-link.active {
    background: #e8efff;
    color: #1B4FD8 !important;
    font-weight: 600;
  }

  @media (max-width: 980px) {
    .blog-layout {
      grid-template-columns: 1fr !important;
    }

    .blog-toc {
      position: static !important;
      grid-column: 1 !important;
    }
  }
</style>

<script>
  const progressEl = document.getElementById('reading-progress');
  const articleEl = document.getElementById('article-content');
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
  const sections = tocLinks
    .map((link) => document.getElementById(link.getAttribute('data-section-id')))
    .filter(Boolean);

  const setActiveToc = (id) => {
    tocLinks.forEach((link) => {
      const active = link.getAttribute('data-section-id') === id;
      link.classList.toggle('active', active);
    });
  };

  const updateProgress = () => {
    if (!articleEl || !progressEl) return;
    const rect = articleEl.getBoundingClientRect();
    const total = rect.height + window.innerHeight;
    const done = window.innerHeight - rect.top;
    const percent = Math.max(0, Math.min(100, (done / total) * 100));
    progressEl.style.width = `${percent}%`;
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible?.target?.id) setActiveToc(visible.target.id);
    },
    { rootMargin: '-35% 0px -55% 0px', threshold: 0.1 }
  );

  sections.forEach((section) => observer.observe(section));
  setActiveToc(sections[0]?.id || '');
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });

  const copyText = async (text, btn) => {
    try {
      await navigator.clipboard.writeText(text);
      if (btn) {
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      }
    } catch {
      if (btn) btn.textContent = 'Copy failed';
    }
  };

  const copyLinkBtn = document.getElementById('copy-link-btn');
  const linkedinBtn = document.getElementById('share-linkedin-btn');
  const xBtn = document.getElementById('share-x-btn');

  copyLinkBtn?.addEventListener('click', () => copyText(window.location.href, copyLinkBtn));

  linkedinBtn?.addEventListener('click', () => {
    const url = encodeURIComponent(window.location.href);
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank', 'noopener,noreferrer');
  });

  xBtn?.addEventListener('click', () => {
    const text = encodeURIComponent(document.title);
    const url = encodeURIComponent(window.location.href);
    window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank', 'noopener,noreferrer');
  });
</script>
