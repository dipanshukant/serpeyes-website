---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../content/config.js';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const isLaunchPost = post.slug === 'serpeyes-digital-growth-agency-what-we-do';
const isAeoCheckPost = post.slug === 'how-to-check-if-your-business-shows-up-in-ai-search';
const isAeoVsGeoPost = post.slug === 'aeo-vs-ai-seo-vs-geo-explained';

const tocItems = isLaunchPost
  ? [
      { id: 'it-started-with-a-gap', label: 'It Started with a Gap' },
      { id: 'what-serpeyes-is-now', label: 'What SerpEyes Is Now' },
      { id: 'what-we-offer', label: 'What We Offer' },
      { id: 'why-we-expanded', label: 'Why We Expanded' },
      { id: 'who-this-is-for', label: 'Who This Is For' },
      { id: 'how-we-work', label: 'How We Work' },
      { id: 'what-happens-next', label: 'What Happens Next' },
      { id: 'one-last-thing', label: 'One Last Thing' },
    ]
  : isAeoCheckPost
  ? [
      { id: 'why-this-matters', label: 'Why This Matters' },
      { id: 'the-questions-to-ask', label: 'The Questions to Ask' },
      { id: 'good-answer-vs-bad-answer', label: 'A Good Answer vs a Bad Answer' },
      { id: 'why-different-from-seo', label: 'Different From Google SEO' },
      { id: 'how-to-fix-it', label: 'How to Fix It' },
      { id: 'how-often-to-check', label: 'How Often to Check' },
      { id: 'a-few-quick-questions', label: 'A Few Quick Questions' },
      { id: 'get-help', label: 'Get Help If You Are Stuck' },
    ]
  : isAeoVsGeoPost
  ? [
      { id: 'why-so-many-terms', label: 'Why So Many Terms' },
      { id: 'what-is-seo', label: 'What Is SEO' },
      { id: 'what-is-aeo', label: 'What Is AEO' },
      { id: 'what-is-geo', label: 'What Is GEO' },
      { id: 'aeo-vs-geo-difference', label: 'AEO vs GEO: The Real Difference' },
      { id: 'what-is-ai-seo', label: 'What Is AI SEO' },
      { id: 'simple-comparison', label: 'A Simple Comparison' },
      { id: 'why-it-matters', label: 'Why This Matters for You' },
      { id: 'get-help', label: 'Get Help With This' },
    ]
  : [
      { id: 'why-this-matters', label: 'Why this matters' },
      { id: 'what-to-fix-first', label: 'What to fix first' },
      { id: 'execution-checklist', label: 'Execution checklist' },
      { id: 'common-mistakes', label: 'Common mistakes' },
      { id: 'next-30-days', label: 'Next 30 days' },
    ];

const sameTagPosts = BLOG_POSTS.filter((item) => item.slug !== post.slug && item.tag === post.tag);
const otherPosts = BLOG_POSTS.filter((item) => item.slug !== post.slug && item.tag !== post.tag);
const relatedPosts = [...sameTagPosts, ...otherPosts].slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.metaTitle || post.title,
  description: post.metaDescription || post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  image: new URL(post.featuredImage, Astro.site).toString(),
  url: canonicalURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  author: { '@type': 'Organization', name: 'SerpEyes', url: 'https://serpeyes.com' },
  publisher: {
    '@type': 'Organization',
    name: 'SerpEyes',
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', Astro.site).toString() },
  },
};

const faqSchema = isAeoCheckPost ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does ranking high on Google mean I will show up in AI search too?',
      acceptedAnswer: { '@type': 'Answer', text: 'Not automatically. It can help, but AEO leans more on clear, consistent facts than on backlinks and search rankings.' },
    },
    {
      '@type': 'Question',
      name: 'Which AI tool matters most, ChatGPT or Perplexity?',
      acceptedAnswer: { '@type': 'Answer', text: 'Check both, and Google AI Overviews too if you can. They pull information from different places and do not always give the same answer about the same business.' },
    },
    {
      '@type': 'Question',
      name: 'How long does it take to start showing up after fixing my details?',
      acceptedAnswer: { '@type': 'Answer', text: 'There is no fixed timeline. AI tools update on their own schedule, not yours, which is exactly why checking regularly matters more than getting it perfect once.' },
    },
  ],
} : null;
---

<BaseLayout
  title={post.metaTitle || `${post.title} - SerpEyes Blog`}
  description={post.metaDescription || post.excerpt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <div id="reading-progress" style="position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: linear-gradient(90deg, #1B4FD8 0%, #3b82f6 100%); z-index: 100;"></div>
  <main>
    <section style="padding: 64px 24px 24px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div style="max-width: 780px; margin-left: 30px;">
          <a href="/blog" style="display: inline-block; margin-bottom: 18px; font-size: 14px; color: #1B4FD8; text-decoration: none; font-weight: 600;">&larr; Back to Blog</a>
          <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap;">
            <span style="background: #eff4ff; color: #1B4FD8; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 100px;">{post.tag}</span>
            <span style="font-size: 13px; color: #94a3b8;">{post.date}</span>
            <span style="font-size: 13px; color: #94a3b8;">{post.readTime}</span>
          </div>
          <h1 style="font-family: Sora, sans-serif; font-size: 40px; font-weight: 700; color: #0f172a; margin: 0 0 14px; line-height: 1.2; letter-spacing: -0.02em;">
            {post.title}
          </h1>
          <p style="font-size: 18px; color: #475569; line-height: 1.8; margin: 0;">
            {post.excerpt}
          </p>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px;">
            <button id="copy-link-btn" type="button" style="background: #dfe8ff; color: #1B4FD8; border: 1px solid #b8cdfa; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Copy Link</button>
            <button id="share-linkedin-btn" type="button" style="background: #dde7ff; color: #1d4ed8; border: 1px solid #b8cdfa; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Share on LinkedIn</button>
            <button id="share-x-btn" type="button" style="background: #e2e8f0; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 8px 12px; cursor: pointer;">Share on X</button>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 24px 24px 88px; background: #eef2f7;">
      <div class="blog-layout" style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 28px; align-items: start;">
        <aside class="blog-toc" style="grid-column: 2; grid-row: 1; position: sticky; top: 92px; background: #e3eaf4; border: 1px solid #c6d2e3; border-radius: 14px; padding: 16px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);">
          <p style="margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #64748b; text-transform: uppercase;">In this article</p>
          <nav style="display: grid; gap: 8px;">
            {tocItems.map((item) => (
              <a href={`#${item.id}`} class="toc-link" data-section-id={item.id} style="font-size: 14px; color: #475569; text-decoration: none; line-height: 1.4; padding: 6px 8px; border-radius: 8px;">{item.label}</a>
            ))}
          </nav>

          <div style="border-top: 1px solid #e2e8f0; margin-top: 14px; padding-top: 14px;">
            <p style="margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #64748b; text-transform: uppercase;">Related posts</p>
            <div style="display: grid; gap: 10px;">
              {relatedPosts.map((item) => (
                <a href={`/blog/${item.slug}`} class="card-hover" style="text-decoration: none; background: #edf3fb; border: 1px solid #bccbe0; border-radius: 10px; padding: 10px; display: block;">
                  <span style="display: inline-block; background: #eff4ff; color: #1B4FD8; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 100px; margin-bottom: 6px;">{item.tag}</span>
                  <h4 style="font-family: Sora, sans-serif; font-size: 13px; color: #0f172a; margin: 0 0 5px; line-height: 1.35;">{item.title}</h4>
                  <p style="font-size: 11px; color: #64748b; margin: 0;">{item.readTime}</p>
                </a>
              ))}
            </div>
          </div>
        </aside>

        <div style="grid-column: 1; grid-row: 1;">
          <article id="article-content" class="animate-on-scroll" style="max-width: 780px; margin: 0 auto 28px; background: #ebf0f7; border: 1px solid #cbd7e6; border-radius: 16px; padding: 32px 28px;">
            {isLaunchPost ? (
              <>
                <section id="it-started-with-a-gap" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">It Started with a Gap</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We started SerpEyes focused on one thing: SEO. Along the way, the same pattern kept showing up.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Clients with strong SEO potential were held back by a website that was slow, hard to update or simply not built to convert. Clients who wanted an app had nowhere to turn without hiring a second, unrelated vendor. Clients who wanted marketing support ended up managing three separate teams that never talked to each other.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We kept referring this work out. Eventually we stopped referring it out and started building the capability ourselves.</p>
                </section>

                <section id="what-serpeyes-is-now" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What SerpEyes Is Now</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">SerpEyes is a digital growth agency. We help businesses establish, optimise and scale their online presence through website development, mobile app development, SEO, AEO and digital marketing.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We are not trying to be everything to everyone. We focus on the parts of a business's digital presence that need to work together to actually produce growth: the site or app people land on, and the search and marketing systems that bring them there.</p>
                </section>

                <section id="what-we-offer" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What We Offer</h2>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 8px;"><strong>Website & eCommerce Development:</strong> Custom business websites and online stores built on modern, secure technology.</li>
                    <li style="margin-bottom: 8px;"><strong>Mobile App Development:</strong> Android and iOS apps, from concept through to app store launch.</li>
                    <li style="margin-bottom: 8px;"><strong>UI/UX Design:</strong> Interfaces designed around how people actually use them, not assumptions.</li>
                    <li style="margin-bottom: 8px;"><strong>SEO:</strong> Technical, on-page and content SEO built for sustained visibility.</li>
                    <li style="margin-bottom: 8px;"><strong>AEO (Answer Engine Optimisation):</strong> Structuring content so AI tools like <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">ChatGPT</a> and <a href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">Perplexity</a> can find and recommend your business.</li>
                    <li><strong>Digital Marketing:</strong> Social media, content strategy and campaigns that turn attention into leads.</li>
                  </ul>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">See the full breakdown on our <a href="/services" style="color: #1B4FD8; text-decoration: underline;">Services page</a>.</p>
                </section>

                <section id="why-we-expanded" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why We Expanded</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">SEO alone can only do so much if the site it is pointing to is not built to convert. We saw this constantly: rankings improving, traffic increasing, and conversion rates barely moving because the website itself was the weak link.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Expanding into web development, app development and full digital marketing let us fix the whole system instead of one piece of it.</p>
                </section>

                <section id="who-this-is-for" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Who This Is For</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">SerpEyes works with businesses at different stages.</p>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 8px;">If you need a new website or online store, see <a href="/web-development" style="color: #1B4FD8; text-decoration: underline;">Web Development</a>.</li>
                    <li style="margin-bottom: 8px;">If you have an app idea or need one built, see <a href="/app-development" style="color: #1B4FD8; text-decoration: underline;">App Development</a>.</li>
                    <li>If you already have a site and need more visibility, see our <a href="/services" style="color: #1B4FD8; text-decoration: underline;">Services page</a> for SEO, AEO and marketing.</li>
                  </ul>
                </section>

                <section id="how-we-work" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How We Work</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We do not apply the same playbook to every client. Every project starts with understanding your market, your customers and what is actually holding growth back, then we build a plan around that, not a template.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">We also lean on AI-powered workflows for research, content and automation, so we can move faster without cutting corners on quality.</p>
                </section>

                <section id="what-happens-next" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Happens Next</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If any of this is relevant to your business, the best next step is a free consultation. We will look at what you have now, whether that is a website, an app idea or an existing SEO setup, and tell you honestly what would move the needle first.</p>
                </section>

                <section id="one-last-thing" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">One Last Thing</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">We kept the name SerpEyes because the idea behind it has not changed: seeing what others miss. That used to mean SEO signals other tools ignored. Now it means seeing the whole picture of a business's digital presence, not just one piece of it.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If that resonates, <a href="/request-demo" style="color: #1B4FD8; text-decoration: underline;">get in touch</a>. We will respond within one business day.</p>
                </section>
              </>
            ) : isAeoCheckPost ? (
              <>
                <section id="why-this-matters" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why This Matters</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">More people are asking AI tools like <a href="https://openai.com/chatgpt" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">ChatGPT</a>, <a href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">Perplexity</a> and Google AI Overviews for help finding a business, instead of typing a search into Google and scrolling through a list of links. They ask a direct question and act on whatever the AI says back.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">This is usually called AI search, and the work of getting found in it is called <a href="/aeo" style="color: #1B4FD8; text-decoration: underline;">AEO, short for Answer Engine Optimisation</a>. It sounds similar to normal SEO, but it works differently. Ranking well on Google does not automatically mean an AI tool knows about your business, or that it will mention you when someone asks.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If your business does not show up in that answer, that customer does not go looking further to find you. They just pick from whatever the AI already told them. That is the whole problem this article is here to help you check, and fix.</p>
                </section>

                <section id="the-questions-to-ask" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">The Questions to Ask</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Open ChatGPT, Perplexity, or any AI chat tool you already use. Type in the kind of question a real customer would ask. Not your business name. A real question, written like you do not know your own business exists yet.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">For example, if you run an aircon company in Singapore, try asking, who is a good aircon company in Singapore. If you run a bakery in London, ask, where is a good bakery in London. If you run a law firm, ask, who is a reliable divorce lawyer in my city.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Ask it two or three different ways. Change a word here and there. Ask about the exact service first, then ask a more general question about your industry in your area.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Try more than one AI tool too. ChatGPT, Perplexity and Google AI Overviews do not always agree. What one of them knows about your business, another one might not have seen at all.</p>
                </section>

                <section id="good-answer-vs-bad-answer" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">A Good Answer vs a Bad Answer</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">A good answer names your business by name. Often it goes further and gives a short reason, pointing to your reviews, your specific services, or your location.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">A bad answer is one of two things. Either your business is skipped completely, or it shows up with wrong details. Wrong phone number. Wrong address. Wrong opening hours. Wrong services.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Wrong details are almost worse than not showing up at all, because the AI is now confidently telling a potential customer the wrong thing about you, and you have no way to correct it in the moment.</p>
                </section>

                <section id="why-different-from-seo" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why This Is Different From Google SEO</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">You might already rank well on Google. That does not automatically carry over to AI search, and this surprises a lot of business owners the first time they check.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;"><a href="/services" style="color: #1B4FD8; text-decoration: underline;">Google SEO</a> is largely about ranking one page against millions of others, built up through backlinks, keywords and technical fixes over years. AEO cares about something more direct, whether an AI model has read clear, consistent facts about your business somewhere, and trusts those facts enough to repeat them to a stranger.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">A business with an ordinary Google ranking but clean, consistent information everywhere can genuinely beat a business that ranks page one on Google but has messy or contradictory details online. Ranking well on Google helps, but it does not guarantee you show up in AI search. The two are related. They are not the same job.</p>
                </section>

                <section id="how-to-fix-it" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How to Fix It</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">If you did not show up, or the details were wrong, here is where to start. Do these roughly in this order, because the earlier ones make the later ones actually work.</p>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 10px;"><strong>Make your details match everywhere.</strong> Your business name, address and phone number should be exactly the same on your website, your Google Business Profile, and any directory you are listed on. Even small differences, a missing unit number, an old phone number still floating around online, are enough to confuse AI tools about which details are actually correct.</li>
                    <li style="margin-bottom: 10px;"><strong>Say what you do in plain words.</strong> Not just pretty pictures and a logo. Actual sentences an AI model can read and quote, like, we fix aircon units in Singapore, same day service available. If a page cannot be read and understood in plain text, it cannot be repeated back to a customer either.</li>
                    <li style="margin-bottom: 10px;"><strong>Keep your <a href="https://support.google.com/business/answer/9798848" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">Google Business Profile</a> filled in.</strong> Hours, photos, services, categories, all of it. This is one of the sources AI tools lean on heavily for local business facts, and an empty or outdated profile actively works against you.</li>
                    <li><strong>Get real reviews, and keep getting them.</strong> AI tools notice when real customers are actively talking about a business online. A handful of old reviews from years ago says something very different to these systems than a steady stream of recent ones.</li>
                  </ul>
                </section>

                <section id="how-often-to-check" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">How Often to Check</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Do this check every month or two, not just once. AI answers change as the underlying tools update, sometimes without any announcement. What worked last month might not work today, and what does not work today might start working next month for reasons that are not always visible from the outside. Treat it as an ongoing habit, not a task you cross off a list.</p>
                </section>

                <section id="a-few-quick-questions" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">A Few Quick Questions</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 6px;"><strong>Does ranking high on Google mean I will show up in AI search too?</strong></p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Not automatically. It can help, but AEO leans more on clear, consistent facts than on backlinks and search rankings.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 6px;"><strong>Which AI tool matters most, ChatGPT or Perplexity?</strong></p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Check both, and Google AI Overviews too if you can. They pull information from different places and do not always give the same answer about the same business.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 6px;"><strong>How long does it take to start showing up after fixing my details?</strong></p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">There is no fixed timeline. AI tools update on their own schedule, not yours, which is exactly why checking regularly matters more than getting it perfect once.</p>
                </section>

                <section id="get-help" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Get Help If You Are Stuck</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If you tried this and your business is missing, or the details are wrong, and you are not sure how to fix it, that is exactly what <a href="/about" style="color: #1B4FD8; text-decoration: underline;">SerpEyes</a> does. <a href="/aeo" style="color: #1B4FD8; text-decoration: underline;">Book a free AEO check</a> and we will show you exactly what is missing and how to fix it.</p>
                </section>
              </>
            ) : isAeoVsGeoPost ? (
              <>
                <section id="why-so-many-terms" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why So Many Terms</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">You have probably seen SEO, AEO, AI SEO and GEO all used to talk about the same general idea, getting your business found online. That is confusing, even for adults.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">This article explains each term in plain words, no confusing jargon, so you actually understand what people mean when they use them.</p>
                </section>

                <section id="what-is-seo" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Is SEO</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">SEO stands for Search Engine Optimisation.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Think of Google as a giant library with billions of books, but no librarian to help you. SEO is the work of making your book, your website, easy to find and worth reading, so Google puts it near the top of the shelf when someone searches for something related to it.</p>
                </section>

                <section id="what-is-aeo" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Is AEO</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">AEO stands for <a href="/aeo" style="color: #1B4FD8; text-decoration: underline;">Answer Engine Optimisation</a>.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Imagine a teacher asks the whole class a question. Lots of students raise their hands, but the teacher can only call on one. AEO is the work of making sure your business is the one the teacher picks, when a customer asks something like who is a good dentist near me. It is not about being on a list. It is about being the answer.</p>
                </section>

                <section id="what-is-geo" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Is GEO</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">GEO stands for Generative Engine Optimisation. It is newer and more specific than AEO.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">When you ask <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">ChatGPT</a> a question, it does not just point at one webpage. It writes a brand new paragraph, in its own words, using facts it has picked up from many places. GEO is the work of making sure your business is one of those facts, so you get mentioned inside the AI's own written answer, not just picked as a single link.</p>
                </section>

                <section id="aeo-vs-geo-difference" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">AEO vs GEO: The Real Difference</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">AEO and GEO sound almost the same, and most people use them to mean the same thing. That is fine for everyday use.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">If you want the precise difference, AEO is older and wider. It covers any tool that gives a direct answer instead of a list of links, including voice assistants like Siri and Google's answer boxes. GEO is newer and narrower. It focuses only on AI tools that generate a written answer, like ChatGPT and <a href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer" style="color: #1B4FD8; text-decoration: underline;">Perplexity</a>. Every GEO result is a kind of AEO result. Not every AEO result is GEO.</p>
                </section>

                <section id="what-is-ai-seo" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What Is AI SEO</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">AI SEO is not an official, exact term the way SEO and AEO are. Different people use it to mean different things.</p>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Some people use it to mean AEO and GEO combined. Others use it to mean using AI tools to help write regular SEO content faster. If someone says AI SEO to you, the safest move is to ask what they actually mean, because the term alone does not tell you much.</p>
                </section>

                <section id="simple-comparison" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">A Simple Comparison</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0 0 16px;">Here is the short version, side by side.</p>
                  <ul style="margin: 0 0 16px 20px; padding: 0; color: #334155; font-size: 16px; line-height: 1.9;">
                    <li style="margin-bottom: 8px;"><strong>SEO:</strong> helps you show up in a list of links on Google.</li>
                    <li style="margin-bottom: 8px;"><strong>AEO:</strong> helps you get picked as the one direct answer, on Google, Siri, or an AI tool.</li>
                    <li style="margin-bottom: 8px;"><strong>GEO:</strong> helps you become one of the facts an AI tool uses when it writes its own answer, like ChatGPT.</li>
                    <li><strong>AI SEO:</strong> not one exact thing, usually means AEO and GEO together, or using AI to help with normal SEO work.</li>
                  </ul>
                </section>

                <section id="why-it-matters" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why This Matters for You</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">More people are skipping the list of links completely and just asking an AI tool for the answer. If your business is not part of that answer, it does not matter how good your website looks, that customer already made a choice before they ever visited your site. That is why <a href="/about" style="color: #1B4FD8; text-decoration: underline;">SerpEyes</a> treats AEO and GEO as one connected goal, not two separate side projects.</p>
                </section>

                <section id="get-help" style="scroll-margin-top: 110px; margin-top: 28px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Get Help With This</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.9; margin: 0;">Not sure if your business actually shows up when people ask AI tools these kinds of questions? Read our other guide, <a href="/blog/how-to-check-if-your-business-shows-up-in-ai-search" style="color: #1B4FD8; text-decoration: underline;">how to check if your business shows up in AI search</a>, or <a href="/aeo" style="color: #1B4FD8; text-decoration: underline;">book a free AEO check</a> and we will show you exactly where you stand.</p>
                </section>
              </>
            ) : (
              <>
                <section id="why-this-matters" style="scroll-margin-top: 110px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Why this matters</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Most businesses lose momentum by treating SEO like disconnected tasks. Ranking gains come faster when technical fixes, content strategy and authority signals are executed in the right sequence for your market.</p>
                </section>

                <section id="what-to-fix-first" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">What to fix first</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Start with crawlability, indexation and page speed. Then improve page-level targeting by tightening title tags, H1 hierarchy and internal links. This sequence prevents content effort from being wasted on a weak foundation.</p>
                </section>

                <section id="execution-checklist" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Execution checklist</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Use this weekly rhythm: publish one intent-focused article, refresh one high-potential page, and build at least one relevant local authority link. Small, consistent moves outperform sporadic large pushes.</p>
                </section>

                <section id="common-mistakes" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Common mistakes</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 16px;">Teams often overinvest in top-funnel blog volume while service pages stay under-optimized. Another common miss is ignoring local trust signals, which directly impacts conversion once rankings improve.</p>
                </section>

                <section id="next-30-days" style="scroll-margin-top: 110px; margin-top: 26px;">
                  <h2 style="font-family: Sora, sans-serif; font-size: 24px; color: #0f172a; margin: 0 0 12px;">Next 30 days</h2>
                  <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0;">Build a simple 4-week plan with measurable outcomes: pages fixed, pages published, links acquired and lead growth trend. Reviewing this every week creates a compounding system rather than random SEO activity.</p>
                </section>
              </>
            )}
          </article>

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .toc-link.active {
    background: #e8efff;
    color: #1B4FD8 !important;
    font-weight: 600;
  }

  @media (max-width: 980px) {
    .blog-layout {
      grid-template-columns: 1fr !important;
    }

    .blog-toc {
      position: static !important;
      grid-column: 1 !important;
    }
  }
</style>

<script>
  const progressEl = document.getElementById('reading-progress');
  const articleEl = document.getElementById('article-content');
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
  const sections = tocLinks
    .map((link) => document.getElementById(link.getAttribute('data-section-id')))
    .filter(Boolean);

  const setActiveToc = (id) => {
    tocLinks.forEach((link) => {
      const active = link.getAttribute('data-section-id') === id;
      link.classList.toggle('active', active);
    });
  };

  const updateProgress = () => {
    if (!articleEl || !progressEl) return;
    const rect = articleEl.getBoundingClientRect();
    const total = rect.height + window.innerHeight;
    const done = window.innerHeight - rect.top;
    const percent = Math.max(0, Math.min(100, (done / total) * 100));
    progressEl.style.width = `${percent}%`;
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible?.target?.id) setActiveToc(visible.target.id);
    },
    { rootMargin: '-35% 0px -55% 0px', threshold: 0.1 }
  );

  sections.forEach((section) => observer.observe(section));
  setActiveToc(sections[0]?.id || '');
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });

  const copyText = async (text, btn) => {
    try {
      await navigator.clipboard.writeText(text);
      if (btn) {
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      }
    } catch {
      if (btn) btn.textContent = 'Copy failed';
    }
  };

  const copyLinkBtn = document.getElementById('copy-link-btn');
  const linkedinBtn = document.getElementById('share-linkedin-btn');
  const xBtn = document.getElementById('share-x-btn');

  copyLinkBtn?.addEventListener('click', () => copyText(window.location.href, copyLinkBtn));

  linkedinBtn?.addEventListener('click', () => {
    const url = encodeURIComponent(window.location.href);
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank', 'noopener,noreferrer');
  });

  xBtn?.addEventListener('click', () => {
    const text = encodeURIComponent(document.title);
    const url = encodeURIComponent(window.location.href);
    window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank', 'noopener,noreferrer');
  });
</script>
