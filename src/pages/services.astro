---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES_HERO, SERVICES_SECTION, SERVICES_CARDS, SERVICES_TESTIMONIALS_SECTION, SERVICES_TESTIMONIALS, QUOTE_SECTION, MARKETS_SECTION, MARKETS, SERVICES_CTA } from '../content/config.js';
---

<BaseLayout
  title="Digital Growth Services - Web, App, SEO and AEO by SerpEyes"
  description="Website development, app development, SEO, AEO and digital marketing services from SerpEyes. One team, built around your business goals."
>
  <main>
    <section style="padding: 80px 24px 64px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 760px; margin: 0 auto; text-align: center;">
        <span class="badge" style="margin-bottom: 16px; display: inline-block;">{SERVICES_HERO.badge}</span>
        <h1 style="font-family: Sora, sans-serif; font-size: clamp(30px, 5vw, 50px); font-weight: 700; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.02em;">
          {SERVICES_HERO.headline}
        </h1>
        <p style="font-size: 17px; color: #475569; line-height: 1.7; margin: 0 0 36px;">
          {SERVICES_HERO.sub}
        </p>
        <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; text-decoration: none; display: inline-block;">
          {SERVICES_HERO.btn}
        </a>
      </div>
    </section>

    <section style="padding: 72px 24px; background: white;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 48px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #0f172a; margin: 0 0 12px; letter-spacing: -0.02em;">{SERVICES_SECTION.headline}</h2>
          <p style="font-size: 16px; color: #64748b; max-width: 580px; margin: 0 auto; line-height: 1.75;">{SERVICES_SECTION.sub}</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 72px;">
          {SERVICES_CARDS.map((item, i) => (
            <div class="animate-on-scroll card-hover" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden;">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 3px; background: ${item.accent};`}></div>
              <div style={`width: 48px; height: 48px; background: ${item.iconBg}; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;`}>
                <span set:html={item.icon}></span>
              </div>
              <h3 style="font-family: Sora, sans-serif; font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 10px;">{item.title}</h3>
              <p style="font-size: 14px; color: #475569; line-height: 1.75; margin: 0;">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 28px;">
          <span class="badge" style="margin-bottom: 14px; display: inline-block;">{SERVICES_TESTIMONIALS_SECTION.badge}</span>
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #0f172a; margin: 0 0 12px; letter-spacing: -0.02em;">
            {SERVICES_TESTIMONIALS_SECTION.headline}
          </h2>
          <p style="font-size: 16px; color: #64748b; max-width: 650px; margin: 0 auto; line-height: 1.75;">
            {SERVICES_TESTIMONIALS_SECTION.sub}
          </p>
        </div>

        <div class="testimonials-marquee" style="margin: 0 0 72px;">
          <div class="testimonials-track">
            {[...SERVICES_TESTIMONIALS, ...SERVICES_TESTIMONIALS].map((item, index) => (
              <a class="testimonial-card" href={item.website} target="_blank" rel="noopener noreferrer" aria-hidden={index >= SERVICES_TESTIMONIALS.length ? 'true' : 'false'}>
                <div style={`height: 100px; border: 1px solid ${item.company === 'Scanstar Inspection Technology' ? '#334155' : '#b8c5d6'}; border-radius: 12px; display: flex; align-items: center; justify-content: center; padding: 12px; background: ${item.company === 'Scanstar Inspection Technology' ? 'linear-gradient(90deg, #0f172a 0%, #111d3f 100%)' : '#d7dee9'}; margin-bottom: 14px;`}>
                  {item.logo ? (
                    <img src={item.logo} alt={`${item.company} logo`} style={`width: ${item.company === 'Truleum Loft Specialist' ? '3500px' : '220px'}; height: ${item.company === 'Truleum Loft Specialist' ? '76px' : '64px'}; object-fit: contain;`} loading="lazy" />
                  ) : (
                    <span style="font-family: Sora, sans-serif; font-size: 22px; font-weight: 700; color: #0f172a; letter-spacing: -0.02em;">{item.short}</span>
                  )}
                </div>
                <strong style="display: block; font-family: Sora, sans-serif; font-size: 15px; color: #0f172a; margin-bottom: 6px; line-height: 1.4;">{item.company}</strong>
                <span style="font-size: 13px; color: #1B4FD8; font-weight: 600;">Visit site &rarr;</span>
              </a>
            ))}
          </div>
        </div>

        <div class="animate-on-scroll" style="background: #0f172a; border-radius: 20px; padding: 48px 32px; text-align: center;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 32px); font-weight: 700; color: white; margin: 0 0 14px;">
            {QUOTE_SECTION.headline}
          </h2>
          <p style="font-size: 16px; color: #9fb2d9; max-width: 620px; margin: 0 auto 28px; line-height: 1.75;">
            {QUOTE_SECTION.sub}
          </p>
          <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; text-decoration: none; display: inline-block;">
            {QUOTE_SECTION.btn}
          </a>
        </div>
      </div>
    </section>

    <!-- MARKETS WE SERVE SECTION -->
    <section style="padding: 72px 24px; background: #f8faff;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 48px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #0f172a; margin: 0 0 12px;">
            {MARKETS_SECTION.headline}
          </h2>
          <p style="font-size: 16px; color: #64748b; max-width: 700px; margin: 0 auto;">
            {MARKETS_SECTION.sub}
          </p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px;">
          {MARKETS.map(market => (
            <div class="animate-on-scroll card-hover" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 14px; padding: 28px 24px; text-align: center;">
              <div style={`width: 52px; height: 52px; border-radius: 50%; background: ${market.bg}; color: ${market.color}; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-family: Sora, sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.02em;`}>{market.code}</div>
              <h3 style="font-family: Sora, sans-serif; font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px;">
                {market.market}
              </h3>
              <p style="font-size: 14px; color: #475569; line-height: 1.7; margin: 0;">
                {market.note}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA BANNER SECTION -->
    <section style="padding: 80px 24px; background: linear-gradient(135deg, #1B4FD8 0%, #1640c4 100%);">
      <div style="max-width: 600px; margin: 0 auto; text-align: center;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: white; margin: 0 0 16px; letter-spacing: -0.02em;">
          {SERVICES_CTA.headline}
        </h2>
        <p style="font-size: 16px; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0 0 32px;">
          {SERVICES_CTA.sub}
        </p>
        <button
          onClick={() => window.location.href = '/request-demo'}
          style="background: white; color: #1B4FD8; border: none; border-radius: 10px; font-weight: 600; font-size: 16px; padding: 14px 32px; cursor: pointer; font-family: 'DM Sans', sans-serif;"
        >
          {SERVICES_CTA.btn}
        </button>
      </div>
    </section>
  </main>

  <style>
    .testimonials-marquee {
      position: relative;
      overflow: hidden;
      padding: 0 6px;
    }

    .testimonials-track {
      display: flex;
      width: max-content;
      gap: 16px;
      animation: testimonials-scroll 34s linear infinite;
      padding: 4px 6px;
    }

    .testimonials-marquee:hover .testimonials-track,
    .testimonials-marquee:focus-within .testimonials-track {
      animation-play-state: paused;
    }

    .testimonial-card {
      width: 360px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      text-decoration: none;
    }

    .testimonial-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 24px rgba(15, 23, 42, 0.14);
      border-color: #94a3b8;
    }

    @keyframes testimonials-scroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(calc(-50% - 8px));
      }
    }

    @media (max-width: 768px) {
      .testimonial-card {
        width: 300px;
      }

      .testimonials-track {
        animation-duration: 28s;
      }
    }
  </style>
</BaseLayout>
