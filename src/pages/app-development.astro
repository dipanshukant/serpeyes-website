---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APPDEV_HERO, APPDEV_CARDS, APPDEV_TESTIMONIALS, APPDEV_CTA_BTN } from '../content/config.js';
---

<BaseLayout
  title="App Development Services - Serpeyes"
  description="Android and iOS app development by Serpeyes. From concept and UI/UX design through to app store launch and ongoing maintenance."
>
  <main>
    <section style="padding: 80px 24px 64px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 760px; margin: 0 auto; text-align: center;">
        <span class="badge" style="margin-bottom: 16px; display: inline-block;">{APPDEV_HERO.badge}</span>
        <h1 style="font-family: Sora, sans-serif; font-size: clamp(30px, 5vw, 50px); font-weight: 700; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.02em;">
          {APPDEV_HERO.headline}
        </h1>
        <p style="font-size: 17px; color: #475569; line-height: 1.7; margin: 0 0 36px;">
          {APPDEV_HERO.sub}
        </p>
        <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; text-decoration: none; display: inline-block;">
          {APPDEV_HERO.btn}
        </a>
      </div>
    </section>

    <section style="padding: 72px 24px; background: white;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px;">
          {APPDEV_CARDS.map((item, i) => (
            <div class="animate-on-scroll card-hover" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden; box-shadow: 0 8px 22px rgba(15,23,42,0.04);">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 3px; background: ${item.accent};`}></div>
              <div style={`width: 48px; height: 48px; background: ${item.iconBg}; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;`}>
                <span set:html={item.icon}></span>
              </div>
              <h2 style="font-family: Sora, sans-serif; font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 10px;">{item.title}</h2>
              <p style="font-size: 14px; color: #475569; line-height: 1.75; margin: 0;">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="padding: 72px 24px; background: #f8faff;">
      <div style="max-width: 700px; margin: 0 auto; text-align: center;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 32px); font-weight: 700; color: #0f172a; margin: 0 0 16px;">
          What Clients Say About Our App Work
        </h2>
        <div style="display: grid; gap: 20px; margin-top: 32px;">
          {APPDEV_TESTIMONIALS.map(t => (
            <div class="animate-on-scroll" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 14px; padding: 28px 24px; text-align: left;">
              <p style="font-size: 15px; color: #475569; line-height: 1.7; margin: 0 0 16px; font-style: italic;">
                "{t.quote}"
              </p>
              <p style="font-size: 14px; font-weight: 600; color: #1B4FD8; margin: 0 0 2px;">{t.name}</p>
              <p style="font-size: 13px; color: #94a3b8; margin: 0;">{t.role}</p>
            </div>
          ))}
        </div>
        <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; margin-top: 40px; text-decoration: none; display: inline-block;">
          {APPDEV_CTA_BTN}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
