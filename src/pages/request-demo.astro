---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoForm from '../components/DemoForm.jsx';
---

<BaseLayout
  title="Contact Us - Serpeyes"
  description="Tell us about your project, website, app, SEO, AEO or marketing, and we will get back to you with a clear next step."
>
  <main style="min-height: 80vh;">
    <section style="padding: 80px 24px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 640px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 48px;">
          <span class="badge" style="margin-bottom: 16px; display: inline-block;">Contact Us</span>
          <h1 style="font-family: Sora, sans-serif; font-size: clamp(28px, 4vw, 40px); font-weight: 700; color: #0f172a; margin: 0 0 16px; letter-spacing: -0.02em;">
            Tell Us What You Need
          </h1>
          <p style="font-size: 16px; color: #475569; line-height: 1.7; margin: 0;">
            Whether it is a new website, a mobile app, stronger SEO or full digital marketing, tell us your goals and we will recommend the right next step.
          </p>
        </div>
        <DemoForm client:load />
      </div>
    </section>
  </main>
</BaseLayout>
