---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING_HERO, PRICING_RETAINERS, PRICING_QUOTES } from '../content/config.js';
---

<BaseLayout
  title="Pricing - Serpeyes"
  description="SEO, AEO and digital marketing retainers, plus custom-quoted web and app development. Simple monthly plans built around how long real results take."
>
  <main>
    <section style="padding: 80px 24px 56px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 760px; margin: 0 auto; text-align: center;">
        <span class="badge" style="margin-bottom: 16px; display: inline-block;">{PRICING_HERO.badge}</span>
        <h1 style="font-family: Sora, sans-serif; font-size: clamp(30px, 5vw, 48px); font-weight: 700; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.02em;">
          {PRICING_HERO.headline}
        </h1>
        <p style="font-size: 17px; color: #475569; line-height: 1.7; margin: 0;">
          {PRICING_HERO.sub}
        </p>
      </div>
    </section>

    <section style="padding: 24px 24px 72px; background: white;">
      <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        {PRICING_RETAINERS.map(plan => (
          <div
            class="animate-on-scroll card-hover"
            style={`position: relative; background: white; border: 1px solid ${plan.popular ? '#1B4FD8' : '#cbd5e1'}; border-radius: 18px; padding: 36px 30px; ${plan.popular ? 'box-shadow: 0 12px 32px rgba(27,79,216,0.14);' : ''}`}
          >
            {plan.popular && (
              <span style="position: absolute; top: -13px; left: 30px; background: #1B4FD8; color: white; font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 999px; letter-spacing: 0.02em;">
                MOST POPULAR
              </span>
            )}
            <h3 style="font-family: Sora, sans-serif; font-size: 21px; font-weight: 700; color: #0f172a; margin: 8px 0 8px;">
              {plan.name}
            </h3>
            <p style="font-size: 14.5px; color: #64748b; line-height: 1.6; margin: 0 0 20px; min-height: 44px;">
              {plan.tagline}
            </p>
            <div style="display: flex; align-items: baseline; gap: 6px; margin-bottom: 4px;">
              <span style="font-family: Sora, sans-serif; font-size: 38px; font-weight: 700; color: #0f172a;">
                {plan.currency} {plan.priceMonthly.toLocaleString()}
              </span>
              <span style="font-size: 15px; color: #64748b;">/mo</span>
            </div>
            <p style="font-size: 13px; color: #94a3b8; margin: 0 0 24px;">{plan.billing}</p>
            <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 12px;">
              {plan.features.map(f => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: #334155; line-height: 1.5;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B4FD8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <button
              class="buy-btn"
              data-plan-id={plan.id}
              style={`width: 100%; padding: 14px; border-radius: 10px; font-size: 15.5px; font-weight: 600; font-family: 'DM Sans', sans-serif; cursor: pointer; border: none; ${plan.popular ? 'background: #1B4FD8; color: white;' : 'background: #f1f5f9; color: #0f172a;'}`}
            >
              {plan.cta}
            </button>
          </div>
        ))}
      </div>
    </section>

    <section style="padding: 0 24px 88px; background: white;">
      <div style="max-width: 1000px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 32px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 28px); font-weight: 700; color: #0f172a; margin: 0 0 10px;">
            Custom Builds
          </h2>
          <p style="font-size: 15px; color: #64748b; margin: 0;">Website and app projects vary too much in scope for a fixed number. We quote after a short call.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
          {PRICING_QUOTES.map(item => (
            <div class="animate-on-scroll card-hover" style="background: #f8faff; border: 1px solid #cbd5e1; border-radius: 18px; padding: 32px 30px;">
              <h3 style="font-family: Sora, sans-serif; font-size: 19px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">
                {item.name}
              </h3>
              <p style="font-size: 14.5px; color: #64748b; line-height: 1.6; margin: 0 0 22px;">
                {item.tagline}
              </p>
              <a
                href={item.href}
                style="display: inline-block; padding: 12px 24px; border-radius: 10px; font-size: 14.5px; font-weight: 600; text-decoration: none; background: white; color: #1B4FD8; border: 1px solid #1B4FD8;"
              >
                {item.cta}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.buy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const originalText = btn.textContent;
      btn.textContent = 'Redirecting to checkout...';
      btn.disabled = true;
      try {
        const res = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            planId: btn.dataset.planId,
            successUrl: window.location.origin + '/thank-you',
            cancelUrl: window.location.href,
          }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || 'Checkout failed');
        }
      } catch {
        btn.textContent = 'Error — try again';
        btn.disabled = false;
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2500);
      }
    });
  });
</script>
