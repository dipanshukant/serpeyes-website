---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING_HERO, PRICING_RETAINERS, PRICING_QUOTES, PRICING_CURRENCIES } from '../content/config.js';
---

<BaseLayout
  title="Pricing - Serpeyes"
  description="SEO, AEO and digital marketing retainers, plus custom-quoted web and app development. Simple monthly plans built around how long real results take."
>
  <main>
    <section style="padding: 80px 24px 56px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 760px; margin: 0 auto; text-align: center;">
        <span class="badge" style="margin-bottom: 16px; display: inline-block;">{PRICING_HERO.badge}</span>
        <h1 style="font-family: Sora, sans-serif; font-size: clamp(30px, 5vw, 48px); font-weight: 700; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.02em;">
          {PRICING_HERO.headline}
        </h1>
        <p style="font-size: 17px; color: #475569; line-height: 1.7; margin: 0;">
          {PRICING_HERO.sub}
        </p>
      </div>
    </section>

    <section style="padding: 24px 24px 0; background: white;">
      <div style="max-width: 1000px; margin: 0 auto; display: flex; justify-content: center; align-items: center; gap: 10px; margin-bottom: 32px;">
        <label for="currency-select" style="font-size: 14px; color: #64748b;">Show prices in</label>
        <select
          id="currency-select"
          data-currencies={JSON.stringify(PRICING_CURRENCIES)}
          style="font-size: 14px; font-weight: 600; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px; background: white; cursor: pointer; font-family: 'DM Sans', sans-serif;"
        >
          {PRICING_CURRENCIES.map(c => (
            <option value={c.code}>{c.code}</option>
          ))}
        </select>
      </div>
    </section>

    <section style="padding: 0 24px 72px; background: white;">
      <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        {PRICING_RETAINERS.map(plan => (
          <div
            class="animate-on-scroll card-hover"
            style={`position: relative; background: white; border: 1px solid ${plan.popular ? '#1B4FD8' : '#cbd5e1'}; border-radius: 18px; padding: 36px 30px; ${plan.popular ? 'box-shadow: 0 12px 32px rgba(27,79,216,0.14);' : ''}`}
          >
            {plan.popular && (
              <span style="position: absolute; top: -13px; left: 30px; background: #1B4FD8; color: white; font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 999px; letter-spacing: 0.02em;">
                MOST POPULAR
              </span>
            )}
            <h3 style="font-family: Sora, sans-serif; font-size: 21px; font-weight: 700; color: #0f172a; margin: 8px 0 8px;">
              {plan.name}
            </h3>
            <p style="font-size: 14.5px; color: #64748b; line-height: 1.6; margin: 0 0 20px; min-height: 44px;">
              {plan.tagline}
            </p>
            <div style="display: flex; align-items: baseline; gap: 6px; margin-bottom: 4px;">
              <span
                class="price-amount"
                data-base-price={plan.priceMonthly}
                style="font-family: Sora, sans-serif; font-size: 38px; font-weight: 700; color: #0f172a;"
              >
                S${plan.priceMonthly.toLocaleString()}
              </span>
              <span style="font-size: 15px; color: #64748b;">/mo</span>
            </div>
            <p style="font-size: 13px; color: #94a3b8; margin: 0 0 4px;">{plan.billing}</p>
            <p class="price-fx-note" style="font-size: 12px; color: #94a3b8; margin: 0 0 20px; display: none;">Approximate. You are billed in SGD; your card issuer converts it.</p>
            <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 12px;">
              {plan.features.map(f => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: #334155; line-height: 1.5;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B4FD8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <button
              class="buy-btn"
              data-plan-id={plan.id}
              style={`width: 100%; padding: 14px; border-radius: 10px; font-size: 15.5px; font-weight: 600; font-family: 'DM Sans', sans-serif; cursor: pointer; border: none; ${plan.popular ? 'background: #1B4FD8; color: white;' : 'background: #f1f5f9; color: #0f172a;'}`}
            >
              {plan.cta}
            </button>
          </div>
        ))}
      </div>
    </section>

    <section style="padding: 0 24px 88px; background: white;">
      <div style="max-width: 1000px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 32px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 28px); font-weight: 700; color: #0f172a; margin: 0 0 10px;">
            Custom Builds
          </h2>
          <p style="font-size: 15px; color: #64748b; margin: 0;">Website and app projects vary too much in scope for a fixed number. We quote after a short call.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
          {PRICING_QUOTES.map(item => (
            <div class="animate-on-scroll card-hover" style="background: #f8faff; border: 1px solid #cbd5e1; border-radius: 18px; padding: 32px 30px;">
              <h3 style="font-family: Sora, sans-serif; font-size: 19px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">
                {item.name}
              </h3>
              <p style="font-size: 14.5px; color: #64748b; line-height: 1.6; margin: 0 0 22px;">
                {item.tagline}
              </p>
              <a
                href={item.href}
                style="display: inline-block; padding: 12px 24px; border-radius: 10px; font-size: 14.5px; font-weight: 600; text-decoration: none; background: white; color: #1B4FD8; border: 1px solid #1B4FD8;"
              >
                {item.cta}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // ── Currency converter (live rates, ported from the UWSM site) ─────────────
  const currencySelect = document.getElementById('currency-select') as HTMLSelectElement | null;

  if (currencySelect) {
    const fallbackCurrencies: { code: string; symbol: string; rate: number }[] = JSON.parse(
      currencySelect.dataset.currencies || '[]'
    );
    const SYMBOLS: Record<string, string> = Object.fromEntries(
      fallbackCurrencies.map((c) => [c.code, c.symbol])
    );
    const FALLBACK: Record<string, number> = Object.fromEntries(
      fallbackCurrencies.map((c) => [c.code, c.rate])
    );

    const CACHE_KEY = 'serpeyes-fx-rates';
    const CACHE_TS_KEY = 'serpeyes-fx-ts';
    const CACHE_TTL = 24 * 60 * 60 * 1000; // 24 hours

    let liveRates: Record<string, number> = { ...FALLBACK };

    async function fetchRates(): Promise<void> {
      try {
        const tsRaw = localStorage.getItem(CACHE_TS_KEY);
        const cached = localStorage.getItem(CACHE_KEY);
        if (tsRaw && cached && Date.now() - Number(tsRaw) < CACHE_TTL) {
          liveRates = { SGD: 1, ...JSON.parse(cached) };
          return;
        }
        const symbols = Object.keys(SYMBOLS).filter((c) => c !== 'SGD').join(',');
        const res = await fetch(`https://api.frankfurter.dev/v1/latest?base=SGD&symbols=${symbols}`);
        if (!res.ok) throw new Error('fetch failed');
        const data = (await res.json()) as { rates: Record<string, number> };
        liveRates = { SGD: 1, ...data.rates };
        localStorage.setItem(CACHE_KEY, JSON.stringify(data.rates));
        localStorage.setItem(CACHE_TS_KEY, String(Date.now()));
      } catch {
        // silently fall back to FALLBACK rates already set
      }
    }

    const priceEls = document.querySelectorAll<HTMLElement>('.price-amount');
    const fxNoteEls = document.querySelectorAll<HTMLElement>('.price-fx-note');

    function applyCurrency(code: string) {
      const rate = liveRates[code] ?? 1;
      const symbol = SYMBOLS[code] ?? code;
      priceEls.forEach((el) => {
        const base = parseFloat(el.dataset.basePrice || '0');
        if (code === 'SGD') {
          el.textContent = `${symbol}${base.toLocaleString()}`;
          return;
        }
        const converted = Math.round(base * rate * 10) / 10;
        el.textContent = `${symbol}${converted.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })}`;
      });
      fxNoteEls.forEach((el) => {
        el.style.display = code === 'SGD' ? 'none' : 'block';
      });
      try {
        localStorage.setItem('serpeyes-currency', code);
      } catch (_) {}
    }

    const saved = localStorage.getItem('serpeyes-currency') ?? 'SGD';
    currencySelect.value = saved;
    applyCurrency(saved); // instant paint with fallback rates
    fetchRates().then(() => applyCurrency(currencySelect.value)); // refresh once live rates load
    currencySelect.addEventListener('change', () => applyCurrency(currencySelect.value));
  }

  document.querySelectorAll<HTMLButtonElement>('.buy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const originalText = btn.textContent;
      btn.textContent = 'Redirecting to checkout...';
      btn.disabled = true;
      try {
        const res = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            planId: btn.dataset.planId,
            successUrl: window.location.origin + '/thank-you',
            cancelUrl: window.location.href,
          }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || 'Checkout failed');
        }
      } catch {
        btn.textContent = 'Error, try again';
        btn.disabled = false;
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2500);
      }
    });
  });
</script>
