---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScanner from '../components/HeroScanner.jsx';
import EarlyAccessForm from '../components/EarlyAccessForm.jsx';
import FeatureCard from '../components/ui/FeatureCard.astro';
import { 
  HERO, 
  DIFF_SECTION, 
  DIFF_CARDS, 
  FEATURES_SECTION, 
  FEATURES,
  COMING_SOON_SECTION,
  COMING_SOON,
  AUDIENCE_SECTION,
  AUDIENCE,
  CTA_SECTION
} from '../content/config.js';
---

<BaseLayout 
  title="SerpEyes - SEO Intelligence Platform Built for Singapore"
  description="SerpEyes gives Singapore agencies, freelancers and business owners the SEO intelligence to rank higher in their market. White-label reports, site audits, keyword research and more."
>
  <main class="hero-bg">
    <!-- Hero Section -->
    <section style={{ padding: '96px 24px 80px', textAlign: 'center' }}>
      <div style="max-width: 780px; margin: 0 auto;">
        <span class="badge" style="margin-bottom: 20px; display: inline-block;" set:html={HERO.badge}></span>
        <h1 style="font-family: Sora, sans-serif; font-size: 50px; font-weight: 700; color: #0f172a; line-height: 1.15; margin: 0 0 24px; letter-spacing: -0.03em;">
          {HERO.headline} <span class="gradient-text">{HERO.headlineAccent}</span>
        </h1>
        <p style="font-size: clamp(17px, 2.5vw, 20px); color: #475569; line-height: 1.7; margin: 0 0 40px; max-width: 620px; margin-left: auto; margin-right: auto;">
          {HERO.subheadline}
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; text-decoration: none; display: inline-block;">
            {HERO.btn1}
          </a>
          <button class="btn-outline" style="padding: 14px 32px; border-radius: 10px; font-size: 16px;" onclick="document.getElementById('early-access').scrollIntoView({ behavior: 'smooth' })">
            {HERO.btn2}
          </button>
        </div>
        <p style="font-size: 13px; color: #94a3b8; margin-top: 20px;">{HERO.footnote}</p>
      </div>
      <HeroScanner client:load />
    </section>

    <!-- Differentiators Section -->
    <section style="padding: 96px 24px; background: #0f172a;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 56px;">
          <span class="badge" style="margin-bottom: 16px; display: inline-block; background: rgba(27,79,216,0.15); color: #60a5fa;">
            {DIFF_SECTION.badge}
          </span>
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(28px, 4vw, 42px); font-weight: 700; color: white; margin: 0 0 16px; letter-spacing: -0.02em;">
            {DIFF_SECTION.headline}
          </h2>
          <p style="font-size: 17px; color: #64748b; max-width: 560px; margin: 0 auto; line-height: 1.7;">
            {DIFF_SECTION.sub}
          </p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
          {DIFF_CARDS.map(item => (
            <FeatureCard icon={item.icon} title={item.title} description={item.desc} dark={true} />
          ))}
        </div>
      </div>
    </section>

    <section style="padding: 104px 24px 96px; background: #eef2f8;">
      <div style="max-width: 1120px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 56px;">
          <span class="badge" style="margin-bottom: 16px; display: inline-block;">{FEATURES_SECTION.badge}</span>
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(30px, 4vw, 46px); font-weight: 700; color: #0f172a; margin: 0 0 16px; letter-spacing: -0.02em; line-height: 1.2;">
            {FEATURES_SECTION.headline}
          </h2>
          <p style="font-size: 17px; color: #64748b; max-width: 620px; margin: 0 auto; line-height: 1.75;">
            {FEATURES_SECTION.sub}
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; margin-bottom: 72px;">
          {FEATURES.map((f, i) => (
            <div key={i} class="animate-on-scroll card-hover" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, ${f.accent}, ${f.accent});`}></div>
              <div style={`width: 48px; height: 48px; background: ${f.iconBg}; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;`}>
                <span set:html={f.icon}></span>
              </div>
              <h3 style="font-family: Sora, sans-serif; font-size: 19px; font-weight: 700; color: #0f172a; margin: 0 0 10px; line-height: 1.3;">
                {f.title}
              </h3>
              <p style="font-size: 15px; color: #475569; line-height: 1.75; margin: 0;">
                {f.desc}
              </p>
            </div>
          ))}
        </div>

        <div style="width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); background: linear-gradient(135deg, #0b1635 0%, #0f1f47 100%); border-top: 1px solid #1f2f57; border-bottom: 1px solid #1f2f57; padding: 52px 24px;">
          <div style="max-width: 1120px; margin: 0 auto;">
            <div class="animate-on-scroll" style="text-align: center; margin-bottom: 32px;">
              <span class="badge" style="margin-bottom: 14px; display: inline-block; background: #1e3a8a; color: #dbeafe;">{COMING_SOON_SECTION.badge}</span>
              <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #f8fafc; margin: 0 0 12px; letter-spacing: -0.02em;">
                {COMING_SOON_SECTION.headline}
              </h2>
              <p style="font-size: 16px; color: #9fb2d9; max-width: 560px; margin: 0 auto; line-height: 1.75;">
                {COMING_SOON_SECTION.sub}
              </p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; max-width: 760px; margin: 0 auto;">
              {COMING_SOON.map((f, i) => (
                <div key={i} class="animate-on-scroll card-hover" style="background: rgba(255,255,255,0.06); border: 1px dashed #3b4f7f; border-radius: 16px; padding: 26px 24px 24px; position: relative; overflow: hidden; backdrop-filter: blur(2px);">
                  <div style="position: absolute; top: 12px; right: 12px;">
                    <span style="background: #1e3a8a; color: #dbeafe; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 100px; letter-spacing: 0.06em; text-transform: uppercase;">Coming Soon</span>
                  </div>
                  <div style={`width: 48px; height: 48px; background: ${f.iconBg}; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;`}>
                    <span set:html={f.icon}></span>
                  </div>
                  <h3 style="font-family: Sora, sans-serif; font-size: 21px; font-weight: 700; color: #f8fafc; margin: 0 0 10px; line-height: 1.3;">
                    {f.title}
                  </h3>
                  <p style="font-size: 15px; color: #c2d0ea; line-height: 1.75; margin: 0;">
                    {f.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Audience Section -->
    <section style="padding-bottom: 70px; background: #f8faff;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div class="animate-on-scroll" style="text-align: center; margin-bottom: 56px;">
          <span class="badge" style="margin-bottom: 16px; display: inline-block;">{AUDIENCE_SECTION.badge}</span>
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(28px, 4vw, 42px); font-weight: 700; color: #0f172a; margin: 0 0 16px; letter-spacing: -0.02em;">
            {AUDIENCE_SECTION.headline}
          </h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
          {AUDIENCE.map(a => (
            <a href={a.href} class="animate-on-scroll card-hover" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 16px; padding: 36px 28px; text-align: center; cursor: pointer; text-decoration: none; display: block;">
              <div style="font-size: 40px; margin-bottom: 16px;">{a.icon}</div>
              <h3 style="font-family: Sora, sans-serif; font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 12px;">
                {a.title}
              </h3>
              <p style="font-size: 15px; color: #475569; line-height: 1.7; margin: 0 0 20px;">
                {a.desc}
              </p>
              <span style="color: #1B4FD8; font-size: 14px; font-weight: 600;">Learn more &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="early-access" style="padding: 96px 24px; background: linear-gradient(135deg, #1B4FD8 0%, #1640c4 100%);">
      <div class="animate-on-scroll" style="max-width: 600px; margin: 0 auto; text-align: center;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(26px, 4vw, 38px); font-weight: 700; color: white; margin: 0 0 16px; letter-spacing: -0.02em;">
          {CTA_SECTION.headline}
        </h2>
        <p style="font-size: 17px; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0 0 36px;">
          {CTA_SECTION.sub}
        </p>
        <EarlyAccessForm client:load />
      </div>
    </section>
  </main>
</BaseLayout>
