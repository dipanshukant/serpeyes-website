---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  AEO_HERO,
  AEO_COMPARISON,
  AEO_EXPLAINER,
  AEO_PROCESS_SECTION,
  AEO_PROCESS,
  AEO_LIMITS_SECTION,
  AEO_LIMITS,
  AEO_FAQ,
  AEO_CTA,
} from '../content/config.js';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": AEO_FAQ.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Answer Engine Optimisation",
  "provider": { "@type": "Organization", "name": "SerpEyes" },
  "description": "Answer Engine Optimisation and Generative Engine Optimisation services, getting businesses cited in ChatGPT, Perplexity and Google AI Overviews.",
};
---

<BaseLayout
  title="AEO (Answer Engine Optimisation) - SerpEyes"
  description="Answer Engine Optimisation from SerpEyes. Get found when people ask ChatGPT, Perplexity and AI Overviews instead of typing into Google."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main>
    <!-- Hero: left aligned, not centered like the rest of the site -->
    <section style="padding: 80px 24px 64px; background: linear-gradient(180deg, #f8faff 0%, white 100%);">
      <div style="max-width: 780px; margin: 0 auto;">
        <span class="badge" style="margin-bottom: 16px; display: inline-block;">{AEO_HERO.badge}</span>
        <h1 style="font-family: Sora, sans-serif; font-size: clamp(30px, 5vw, 48px); font-weight: 700; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.02em; line-height: 1.2;">
          {AEO_HERO.headline}
        </h1>
        <p style="font-size: 17px; color: #475569; line-height: 1.8; margin: 0 0 32px; max-width: 640px;">
          {AEO_HERO.sub}
        </p>
        <a href="/request-demo" class="btn-primary" style="padding: 14px 32px; border-radius: 10px; font-size: 16px; text-decoration: none; display: inline-block;">
          {AEO_HERO.btn}
        </a>
      </div>
    </section>

    <!-- Comparison: two plain text panels, not a card grid -->
    <section style="padding: 72px 24px; background: #0f172a;">
      <div style="max-width: 900px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 44px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 30px); font-weight: 700; color: white; margin: 0 0 12px; letter-spacing: -0.02em;">
            {AEO_COMPARISON.headline}
          </h2>
          <p style="font-size: 15.5px; color: #9fb2d9; max-width: 560px; margin: 0 auto; line-height: 1.7;">
            {AEO_COMPARISON.sub}
          </p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1px; background: rgba(255,255,255,0.12); border-radius: 16px; overflow: hidden;">
          <div style="background: #131b33; padding: 32px 28px;">
            <span style="display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #64748b; margin-bottom: 16px;">{AEO_COMPARISON.before.label}</span>
            <div style="background: #0b1226; border: 1px solid #253154; border-radius: 8px; padding: 10px 14px; font-size: 14px; color: #cbd5e1; font-family: 'DM Sans', sans-serif; margin-bottom: 18px;">
              {AEO_COMPARISON.before.query}
            </div>
            <p style="font-size: 14.5px; color: #9fb2d9; line-height: 1.75; margin: 0;">{AEO_COMPARISON.before.body}</p>
          </div>
          <div style="background: #131b33; padding: 32px 28px;">
            <span style="display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #60a5fa; margin-bottom: 16px;">{AEO_COMPARISON.after.label}</span>
            <div style="background: #0b1226; border: 1px solid #1B4FD8; border-radius: 8px; padding: 10px 14px; font-size: 14px; color: #cbd5e1; font-family: 'DM Sans', sans-serif; margin-bottom: 18px;">
              {AEO_COMPARISON.after.query}
            </div>
            <p style="font-size: 14.5px; color: #c2d0ea; line-height: 1.75; margin: 0;">{AEO_COMPARISON.after.body}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Explainer: flowing paragraphs, no cards -->
    <section style="padding: 80px 24px; background: white;">
      <div style="max-width: 680px; margin: 0 auto;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #0f172a; margin: 0 0 24px; letter-spacing: -0.02em;">
          {AEO_EXPLAINER.headline}
        </h2>
        {AEO_EXPLAINER.paragraphs.map(p => (
          <p style="font-size: 16px; color: #334155; line-height: 1.85; margin: 0 0 18px;">{p}</p>
        ))}
      </div>
    </section>

    <!-- Process: stepped vertical list, numbers mean something here -->
    <section style="padding: 80px 24px; background: #0b1226;">
      <div style="max-width: 720px; margin: 0 auto;">
        <div style="margin-bottom: 44px;">
          <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: white; margin: 0 0 12px; letter-spacing: -0.02em;">
            {AEO_PROCESS_SECTION.headline}
          </h2>
          <p style="font-size: 15.5px; color: #9fb2d9; margin: 0;">{AEO_PROCESS_SECTION.sub}</p>
        </div>
        <div>
          {AEO_PROCESS.map((step, i) => (
            <div style={`display: flex; gap: 24px; padding: 22px 0; ${i < AEO_PROCESS.length - 1 ? 'border-bottom: 1px solid #253154;' : ''}`}>
              <div style="font-family: Sora, sans-serif; font-size: 22px; font-weight: 700; color: #3b4d78; flex-shrink: 0; width: 44px;">{step.step}</div>
              <div>
                <h3 style="font-family: Sora, sans-serif; font-size: 17px; font-weight: 700; color: white; margin: 0 0 6px;">{step.title}</h3>
                <p style="font-size: 14.5px; color: #9fb2d9; line-height: 1.7; margin: 0;">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Honest limits, deliberately plain, not a sales pitch -->
    <section style="padding: 72px 24px; background: white; border-top: 1px solid #eef2f8;">
      <div style="max-width: 680px; margin: 0 auto;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(22px, 3vw, 28px); font-weight: 700; color: #0f172a; margin: 0 0 10px; letter-spacing: -0.02em;">
          {AEO_LIMITS_SECTION.headline}
        </h2>
        <p style="font-size: 15px; color: #64748b; line-height: 1.7; margin: 0 0 28px;">{AEO_LIMITS_SECTION.sub}</p>
        <ul style="margin: 0; padding: 0; list-style: none;">
          {AEO_LIMITS.map(item => (
            <li style="display: flex; gap: 12px; padding: 14px 0; border-top: 1px solid #eef2f8;">
              <span style="color: #94a3b8; font-size: 14px; flex-shrink: 0;">&middot;</span>
              <span style="font-size: 14.5px; color: #475569; line-height: 1.75;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding: 80px 24px; background: #e2e8f0;">
      <div style="max-width: 720px; margin: 0 auto;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #0f172a; margin: 0 0 32px; letter-spacing: -0.02em;">
          Common Questions
        </h2>
        {AEO_FAQ.map(item => (
          <div style="border-bottom: 1px solid #eef2f8; padding: 22px 0;">
            <h3 style="font-family: Sora, sans-serif; font-size: 16.5px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">{item.q}</h3>
            <p style="font-size: 15px; color: #475569; line-height: 1.75; margin: 0;">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Geo links -->
    <section style="padding: 48px 24px; background: white; border-top: 1px solid #eef2f8; text-align: center;">
      <p style="font-size: 14px; color: #94a3b8; margin: 0 0 12px;">Serving businesses in</p>
      <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
        <a href="/aeo/singapore" style="color: #1B4FD8; font-weight: 600; text-decoration: none; font-size: 15px;">Singapore</a>
        <a href="/aeo/uk" style="color: #1B4FD8; font-weight: 600; text-decoration: none; font-size: 15px;">United Kingdom</a>
      </div>
    </section>

    <!-- CTA -->
    <section style="padding: 80px 24px; background: linear-gradient(135deg, #1B4FD8 0%, #1640c4 100%);">
      <div style="max-width: 600px; margin: 0 auto; text-align: center;">
        <h2 style="font-family: Sora, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: white; margin: 0 0 16px; letter-spacing: -0.02em;">
          {AEO_CTA.headline}
        </h2>
        <p style="font-size: 16px; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0 0 32px;">
          {AEO_CTA.sub}
        </p>
        <a href="/request-demo" style="padding: 14px 32px; background: white; color: #1B4FD8; border: none; border-radius: 10px; font-weight: 600; font-size: 16px; cursor: pointer; font-family: DM Sans, sans-serif; text-decoration: none; display: inline-block;">
          {AEO_CTA.btn}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
